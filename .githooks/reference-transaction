#!/usr/bin/env bash
# Harte Sperre: Läuft bei jeder Branch-Änderung, egal über welchen Git-Befehl
# (commit, --no-verify, --amend, merge, rebase, stash, commit-tree + update-ref).
# Jeder Commit, der neu auf einen Branch kommt, muss scripts/verify-commit.sh bestehen.
set -euo pipefail
[ "${1:-}" = prepared ] || exit 0
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
status=0
while read -r old new ref; do
  case $ref in refs/heads/*) ;; *) continue ;; esac
  [ "$new" != "$zero" ] || continue
  # Nur Commits, die noch auf keinem Branch liegen. Ein Zurücksetzen auf alte Commits prüft nichts neu.
  for c in $(git rev-list --reverse "$new" --not --branches </dev/null); do
    parents=$(git rev-list --parents -n 1 "$c" | wc -w)
    if [ "$parents" -gt 2 ]; then
      echo "reference-transaction: Merge-Commit $c ist nicht vorgesehen. Ein TDD-Zyklus = ein linearer Commit." >&2
      status=1; continue
    fi
    msg=$(mktemp); git log -1 --format=%B "$c" > "$msg"
    scripts/verify-commit.sh "$(git rev-parse "$c^{tree}")" "$(git rev-parse -q --verify "$c^" || true)" "$msg" </dev/null || status=1
    rm -f "$msg"
  done
done
exit "$status"
